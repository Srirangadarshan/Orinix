#!/bin/bash
# omarchy:summary=Install the AI assistant (Ollama + Gemma 3 model)
# omarchy:group=ai
# omarchy:requires-sudo=true
# omarchy:examples=omarchy ai install

set -e

OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
MODEL="${OMARCHY_AI_MODEL:-gemma3:4b}"

if gum confirm "Install Omarchy AI Assistant? This will install Ollama and pull the ${MODEL} model (~2.6GB)."; then
  omarchy-pkg-add ollama
  omarchy-pkg-add python-numpy

  systemctl --user enable --now ollama.service 2>/dev/null || true

  mkdir -p ~/.config/omarchy/ai
  if [[ ! -f ~/.config/omarchy/ai/config.toml ]]; then
    cp "$OMARCHY_PATH/config/omarchy/ai/config.toml" ~/.config/omarchy/ai/
  fi

  echo "Pulling AI model ${MODEL}..."
  ollama pull "$MODEL"

  echo "Pulling embedding model for file search..."
  ollama pull mxbai-embed-large

  echo "Indexing files for AI search..."
  mkdir -p "$HOME/.local/share/omarchy/ai/index"
  python3 "$OMARCHY_PATH/bin/omarchy-ai-index" &>/dev/null &

  omarchy-restart-waybar

  omarchy-notification-send "AI Assistant Ready" "Press SUPER + ; to open the AI chat." -g 󰭻 -u normal
fi
