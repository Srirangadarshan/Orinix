#!/usr/bin/env python3
# omarchy:summary=Index files for AI search (runs automatically)
# omarchy:group=ai
# omarchy:hidden=true
# omarchy:args=[--add <dir>| --remove <dir> | --status | --clear | <directory...>]
# omarchy:examples=omarchy ai index --add ~/Projects | omarchy ai index --status


import sys
import os
import json
import re

OMARCHY_PATH = os.environ.get(
  "OMARCHY_PATH",
  os.path.expanduser("~/.local/share/omarchy"),
)

sys.path.insert(0, os.path.join(OMARCHY_PATH, "default"))

from omarchy_ai.index.indexer import index_directory, index_all_defaults, default_config
from omarchy_ai.index.store import VectorStore
from omarchy_ai.index.search import CONFIG_PATH


def main():
  args = sys.argv[1:]

  if "--status" in args:
    store = VectorStore()
    info = store.status()
    print(f"Index path: {info['path']}")
    print(f"Files indexed: {info['files']}")
    print(f"Chunks indexed: {info['chunks']}")
    _show_dirs()
    return

  if "--clear" in args:
    store = VectorStore()
    store.clear()
    print("Index cleared.")
    return

  if "--add" in args:
    idx = args.index("--add")
    if idx + 1 >= len(args):
      print("Usage: omarchy ai index --add <directory>")
      sys.exit(1)
    directory = os.path.abspath(os.path.expanduser(args[idx + 1]))
    if not os.path.isdir(directory):
      print(f"Directory not found: {directory}")
      sys.exit(1)
    _add_directory(directory)
    cfg = default_config()
    n = index_directory(directory, cfg, verbose=True)
    print(f"Indexed {n} chunks from {directory}")
    return

  if "--remove" in args:
    idx = args.index("--remove")
    if idx + 1 >= len(args):
      print("Usage: omarchy ai index --remove <directory>")
      sys.exit(1)
    directory = os.path.abspath(os.path.expanduser(args[idx + 1]))
    _remove_directory(directory)
    print(f"Removed {directory} from index config.")
    return

  if "--list" in args:
    _show_dirs()
    return

  dirs = [a for a in args if not a.startswith("-")]
  if dirs:
    cfg = default_config()
    for d in dirs:
      n = index_directory(d, cfg, verbose=True)
      if n > 0:
        print(f"Indexed {n} chunks from {d}")
  else:
    index_all_defaults(verbose=True)


def _get_dirs() -> list[str]:
  dirs = default_config().get("directories", [])
  if os.path.exists(CONFIG_PATH):
    try:
      import tomllib
      with open(CONFIG_PATH, "rb") as f:
        user = tomllib.load(f)
      user_dirs = user.get("index", {}).get("directories", [])
      if user_dirs:
        dirs = user_dirs
    except Exception:
      pass
  return dirs


def _show_dirs():
  dirs = _get_dirs()
  print(f"\nIndexed directories ({len(dirs)}):")
  for d in dirs:
    expanded = os.path.expanduser(d)
    exists = os.path.isdir(expanded)
    marker = "\033[32m✓\033[0m" if exists else "\033[33m?\033[0m"
    print(f"  {marker} {d}")
  print()


def _update_config_dirs(dirs: list[str]):
  if not os.path.exists(CONFIG_PATH):
    print(f"Config not found: {CONFIG_PATH}")
    return
  with open(CONFIG_PATH) as f:
    content = f.read()
  new_line = f"directories = {json.dumps(dirs)}"
  content = re.sub(
    r'^directories\s*=\s*\[.*?\]\s*$',
    new_line,
    content,
    flags=re.MULTILINE,
  )
  with open(CONFIG_PATH, "w") as f:
    f.write(content)


def _add_directory(directory: str):
  dirs = _get_dirs()
  if directory in dirs or os.path.expanduser(directory) in [os.path.expanduser(d) for d in dirs]:
    print(f"Already indexed: {directory}")
    return
  dirs.append(directory)
  _update_config_dirs(dirs)
  print(f"Added {directory} to index config.")


def _remove_directory(directory: str):
  dirs = _get_dirs()
  expanded = os.path.expanduser(directory)
  filtered = [d for d in dirs if os.path.expanduser(d) != expanded]
  if len(filtered) == len(dirs):
    print(f"Not in index config: {directory}")
    return
  _update_config_dirs(filtered)
  print(f"Removed {directory} from index config.")


if __name__ == "__main__":
  main()
